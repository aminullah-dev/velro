# Copy to ios/scripts/.env (git-ignored) and fill in. A team key works for
# every app on team 27RXPRW77S, so the one Namazia uploads with will do.
#
# App Store Connect → Users and Access → Integrations → App Store Connect API:
#   Issuer ID  -- shown at the top of that page
#   Key ID     -- the key's row; the .p8 is downloadable once, when made
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
