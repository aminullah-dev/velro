<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the driver app collects, as api.velro.linumic.com/privacy says it.
  App Store Connect's privacy answers must match this file; review both
  together before every upload.

  The passenger's list, and what only a driver sends: photographs of his
  tazkira, licence, car papers and face, taken to verify who is behind the
  wheel; and the earnings and commission his trips add up to. Location is
  precise and continuous while he carries a trip, so the passengers he is
  driving can see the car. Other User Content is the note he may add to a
  price he offers.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
