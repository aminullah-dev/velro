# Copy to .env and fill in real values. .env is gitignored at the repo root
# (see .gitignore: ".env" / ".env.*" / "!.env.example") -- never commit the
# filled-in version.

# Leave unset for a real deployment: the compose file defaults to
# "production", which is what makes config.load refuse a console SMS
# provider or a debug OTP echo. Set to "staging" only for the interim
# period before real Twilio credentials exist -- the first deploy of this
# repo ran exactly that way. Delete the line the day TWILIO_* below are real.
VELRO_ENVIRONMENT=

# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32 -- VELRO_JWT_SECRET must be at least 32 characters
# (infrastructure/services/tokens.py:26 rejects a shorter one at startup)
JWT_SECRET=

# From console.twilio.com -- Account Info panel.
TWILIO_ACCOUNT_SID=
# Prefer an API key over the account Auth Token: it revokes on its own without
# rotating the password to the whole account. With a key, this is its SK... sid
# and TWILIO_AUTH_TOKEN is the key secret. Leave blank to use the account Auth
# Token, in which case the account sid doubles as the username.
TWILIO_API_KEY_SID=
TWILIO_AUTH_TOKEN=
# The registered alphanumeric sender ID ("VELRO"). What Etisalat, MTN, Roshan
# and Salaam require; AWCC will refuse it.
TWILIO_SENDER_ID=
# An international number, in E.164. The only route to AWCC, and the
# fallback everywhere else. Twilio sells no Afghan long code.
TWILIO_SENDER_NUMBER=

# Leave as "twilio" once the two Twilio values above are real. config.load
# refuses to start a production deployment on "console" (infrastructure/
# services/messaging.py's ConsoleSmsSender, which delivers nothing) --
# switching this back is not a way around that check, it is the thing the
# check exists to catch.
SMS_PROVIDER=twilio

# From gateway.telegram.org -> API tab, after topping the balance up. Leave
# empty until then: the sign-in screen still offers Telegram, and a code
# asked for over Telegram simply arrives as an SMS instead. Nobody is locked
# out by an empty value; it only costs more.
TELEGRAM_GATEWAY_TOKEN=

# Comma-separated. Left at its default (admin.velro.linumic.com) unless a
# second admin surface is added -- the admin panel calls its own origin at a
# relative path, so this exists as a safety net rather than a requirement.
CORS_ORIGINS=https://admin.velro.linumic.com

# Comma-separated E.164 numbers that sign in without an SMS being sent -- the
# code comes back in the API response instead. For development only, and only
# for handsets you own. Every number NOT listed here still gets a real message
# at real cost, which is the point: this is not the deployment-wide debug echo.
#
# Clear this before real users arrive.
OTP_TEST_NUMBERS=

# Comma-separated E.164 numbers exempt from the service-area fence -- they
# may ask for a ride from anywhere on earth. This is the operator's own
# handset, and it is NOT the list above: a tester abroad still needs real
# SMS codes on a real phone, and still needs to be able to book.
#
# Everyone else must be within reach of a known station, which is what keeps
# a bored man in another province from ringing every driver at midnight.
GEOFENCE_EXEMPT_PHONES=+13438677631
