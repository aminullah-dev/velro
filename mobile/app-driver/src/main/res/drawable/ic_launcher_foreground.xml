<?xml version="1.0" encoding="utf-8"?>
<!-- The VELRO mark: a road narrowing to a point, which also reads as a V.
     Drawn as a vector so it stays crisp at every density and adds nothing to
     the APK. Kept inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The road, widening towards the viewer. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,78 L36,30 L45,30 L54,58 L63,30 L72,30 Z" />

    <!-- Centre line: three dashes, shortening with distance. -->
    <path
        android:fillColor="#8FD9BC"
        android:pathData="M53,70 h2 v-6 h-2 Z" />
    <path
        android:fillColor="#8FD9BC"
        android:pathData="M53,60 h2 v-5 h-2 Z" />
    <path
        android:fillColor="#8FD9BC"
        android:pathData="M53,51 h2 v-4 h-2 Z" />
</vector>
